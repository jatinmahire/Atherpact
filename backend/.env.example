# AetherPact backend — environment variables. Copy to .env and fill in real
# values for local dev; in production (Render), set these directly in the
# service's Environment Variables tab instead of committing a .env file.
#
# Note: earlier addendum drafts referenced Porter delivery credentials —
# no Porter (or any courier) integration exists anywhere in this codebase,
# so there is nothing to configure for it here.

# Postgres connection string (Neon, Supabase, or any Postgres host).
# Local dev: leave unset to fall back to a local SQLite file automatically.
# Production: always set this to the real hosted Postgres URL.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Comma-separated extra CORS origins allowed on top of localhost:5173/127.0.0.1:5173
# (e.g. the real deployed Vercel frontend URL once known).
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

# Path to the Firebase Admin SDK service-account JSON key file (server-side
# token verification for real Firebase Authentication).
FIREBASE_SERVICE_ACCOUNT_PATH=secrets/firebase-adminsdk.json

# Firebase project id.
FIREBASE_PROJECT_ID=your-firebase-project-id

# Razorpay API keys (test-mode or live), used for real payment order
# creation and server-side signature verification.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# Nugen Intelligence API key (Addendum 9's domain-aligned advisory agents).
NUGEN_API_KEY=nugen-xxxxxxxxxxxxxxxx

# Set to "true" to skip loading Laya (the heaviest of the three real AI
# components, ~800MB) entirely — recommended on a free/memory-constrained
# hosting tier. Every feature that uses Laya already has a real, honest
# neutral-default fallback for this case (never a fake positive result).
DISABLE_LAYA=false
