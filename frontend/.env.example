# AetherPact frontend — environment variables. Copy to .env for local dev.
# Vercel: set these in the project's Environment Variables settings instead.

# Addendum 8, Phase 58: the real deployed backend origin (Render), no /api
# suffix. Leave unset for local dev — falls back to the Vite dev proxy at /api.
VITE_API_BASE_URL=https://your-backend.onrender.com

# Firebase JS SDK config (client-safe values — Firebase's security model
# relies on server-side token verification/rules, not on these being secret).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Razorpay Checkout public key id (safe to expose client-side).
VITE_RAZORPAY_KEY_ID=
